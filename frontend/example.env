# Environment variables for SignupAuth backend
# Replace these with real values before deploying

COMPANY_EMAIL=youraddress@gmail.com
COMPANY_EMAIL_APP_PASSWORD=yourAppPassword
# Optional: change server port (default 3000)
PORT=3000


# Base URL the frontend uses to reach the Express server.
# Local: keep the backend origin (routes are /signup and /login).
# Netlify backend: use the backend origin followed by /api because the
# backend's redirect exposes routes through /.netlify/functions/server.
VITE_API_URL=http://localhost:3000
