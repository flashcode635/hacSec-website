# Environment variables for SignupAuth backend
# Replace these with real values before deploying

COMPANY_EMAIL=youraddress@gmail.com
COMPANY_EMAIL_APP_PASSWORD=yourAppPassword
# Optional: change server port (default 3001)
PORT=3001


# Base URL the frontend uses to reach the Express server in /server.
# Point this at your deployed backend URL when you deploy the site.
VITE_API_URL=http://localhost:3001
